# NeptHass DEVELOPMENT configuration.
# Copy to .env.dev and fill in the values. Never commit .env.dev.
# Use a SEPARATE Discord application and a private test server for development;
# never reuse your production bot token.
#
# Always pass this file to Compose:
#   docker compose --env-file .env.dev -f compose.dev.yaml ...
#
# Guide: docs/development/setup.md

# --- Development Home Assistant -------------------------------------------

# Host port for the Home Assistant UI. It is published on 127.0.0.1 only.
HA_DEV_PORT=18123
# Home Assistant image (pinned for reproducibility). Uncomment to override.
# HA_IMAGE=ghcr.io/home-assistant/home-assistant:2026.10.4

# URL NeptHass uses to reach Home Assistant FROM INSIDE ITS CONTAINER. Do not
# use 127.0.0.1 here: that is the NeptHass container itself.
NEPTHASS_DEV_HA_URL=http://homeassistant:8123

# Long-Lived Access Token created in the development Home Assistant UI after
# onboarding (Profile > Security > Long-lived access tokens). Leave empty
# until then.
HA_TOKEN=

# --- Discord test bot -------------------------------------------------------

DISCORD_BOT_TOKEN=
DISCORD_APPLICATION_ID=
DISCORD_GUILD_ID=
# Your own Discord user ID (a NeptHass administrator).
DISCORD_ADMIN_USER_IDS=
# Optional: users that may use shared entities but cannot manage permissions.
DISCORD_ALLOWED_USER_IDS=
DISCORD_COMMAND_SCOPE=guild

# --- Behaviour ----------------------------------------------------------------

LOG_LEVEL=debug
LOG_FORMAT=text
AUDIT_RETENTION_DAYS=30
