# NeptHass bootstrap configuration.
# Copy to .env and fill in the values. Never commit .env.
# Secrets are configured here, never through Discord.
#
# Every secret can alternatively be read from a file by setting
# DISCORD_BOT_TOKEN_FILE / HA_TOKEN_FILE (for example a Docker secret).

# --- Required -------------------------------------------------------------

# Discord bot token (Developer Portal > Bot > Reset Token).
DISCORD_BOT_TOKEN=
# Discord application ID (Developer Portal > General Information).
DISCORD_APPLICATION_ID=
# ID of the Discord server (guild) NeptHass serves. Enable Developer Mode in
# Discord, then right-click the server > Copy Server ID.
DISCORD_GUILD_ID=
# Comma-separated Discord user IDs of NeptHass administrators.
DISCORD_ADMIN_USER_IDS=
# Home Assistant Long-Lived Access Token (profile page > Security).
HA_TOKEN=

# --- Optional -------------------------------------------------------------

# Comma-separated Discord user IDs that may view and control the entities an
# administrator has shared, but cannot manage permissions. Leave empty for none.
DISCORD_ALLOWED_USER_IDS=
# Where slash commands are registered: "guild" (instant, recommended) or "global".
DISCORD_COMMAND_SCOPE=guild

# Home Assistant base URL. The default works with host networking on Linux.
HA_URL=http://127.0.0.1:8123
# Timeout for each Home Assistant request (1s - 2m).
HA_REQUEST_TIMEOUT=10s

# SQLite database path. The container image already sets /data/nepthass.db.
# DATABASE_PATH=/data/nepthass.db
# How many days of audit log to keep (1 - 3650).
AUDIT_RETENTION_DAYS=90

# debug, info, warn or error.
LOG_LEVEL=info
# text or json.
LOG_FORMAT=text
